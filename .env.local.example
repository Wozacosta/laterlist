OPENAI_API_KEY=sk-...
NEXT_PUBLIC_DEXIE_CLOUD_URL=

# MCP route (/api/mcp). Without these, every request is refused.
# MCP_TOKEN is the private token a client sends. Generate with: openssl rand -hex 32
# The Dexie client needs the ACCESS_DB and IMPERSONATE scopes, and can act as any user
MCP_TOKEN=
MCP_USER_EMAIL=
DEXIE_CLOUD_CLIENT_ID=
DEXIE_CLOUD_CLIENT_SECRET=

# Upstash Redis (server-side storage for API keys, calendar tokens, sessions)
# Add a Redis integration from Vercel Marketplace, or use https://upstash.com
# Without these, falls back to file-based storage (local dev only)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Google Calendar OAuth (LT-60)
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Add-only token for /api/capture and /api/capture/inoreader
CAPTURE_TOKEN=
